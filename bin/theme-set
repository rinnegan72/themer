#!/bin/bash
# theme-set <name> — flip ~/.config/themer/current and reload apps (omarchy-style)
set -euo pipefail
REPO="$(cd "$(dirname "$0")/.." && pwd)"
T="$REPO/themes/${1:-}"
if [ -z "${1:-}" ] || [ ! -d "$T" ]; then
  echo "usage: theme-set <name>" >&2
  ls "$REPO/themes" >&2
  exit 1
fi

mkdir -p "$HOME/.config/themer"
ln -sfn "$T" "$HOME/.config/themer/current"
. "$T/theme.env" # ZED_THEME, NVIM_COLORSCHEME, BACKGROUND, VICINAE_THEME

# macOS system appearance: follow the theme's own dark/light call
DARK=$([ "$BACKGROUND" = dark ] && echo true || echo false)
osascript -e "tell application \"System Events\" to tell appearance preferences to set dark mode to $DARK" >/dev/null 2>&1 || true

# zed: rewrite the "theme" object; hot-reloads on save
# ponytail: regex on JSONC, breaks if a nested { } ever appears inside the theme object
python3 - "$ZED_THEME" "$BACKGROUND" <<'EOF'
import re, sys, pathlib
theme, mode = sys.argv[1], sys.argv[2]
p = pathlib.Path.home() / ".config/zed/settings.json"
if p.exists():
    new = f'"theme": {{\n    "mode": "{mode}",\n    "light": "{theme}",\n    "dark": "{theme}"\n  }}'
    p.write_text(re.sub(r'"theme":\s*\{[^{}]*\}', new, p.read_text(), count=1))
EOF

# vicinae: its CLI writes settings.json and the server applies it live
VC=/Applications/Vicinae.app/Contents/MacOS/vicinae-cli
if [ -x "$VC" ] && [ -n "${VICINAE_THEME:-}" ]; then
  "$VC" theme set "$VICINAE_THEME" >/dev/null 2>&1 || true
fi

# tmux: re-source config (picks up current/tmux.conf fragment)
if tmux ls >/dev/null 2>&1; then
  tmux source-file "$HOME/.config/tmux/tmux.conf"
fi

# ghostty: reads current/ghostty.conf via symlink; nudge a reload
if pgrep -qix ghostty >/dev/null 2>&1; then
  osascript -e 'tell application "System Events" to click menu item "Reload Configuration" of menu 1 of menu bar item "Ghostty" of menu bar 1 of process "Ghostty"' >/dev/null 2>&1 \
    || echo "ghostty: press cmd+shift+, to reload"
fi

# nvim: live-switch every running instance
for s in "${TMPDIR:-/tmp/}"nvim."$USER"/*/nvim.*.0; do
  [ -e "$s" ] || continue
  nvim --server "$s" --remote-send "<C-\\><C-n>:set background=$BACKGROUND<CR>:colorscheme $NVIM_COLORSCHEME<CR>" >/dev/null 2>&1 || true
done

# starship: swap only the [palettes.themer] table + `palette = "themer"` line, between
# markers install.sh already placed — everything else in the user's starship.toml
# (module config, format string) is never read or touched.
python3 - "$T/starship.toml" <<'EOF'
import re, sys, pathlib
frag = pathlib.Path(sys.argv[1]).read_text().rstrip("\n")
p = pathlib.Path.home() / ".config/starship.toml"
if p.exists():
    text = p.read_text()
    text = re.sub(
        r'(# >>> themer palette table \(auto-managed\) >>>\n).*?(\n# <<< themer palette table <<<)',
        lambda m: m.group(1) + frag + m.group(2), text, count=1, flags=re.S)
    p.write_text(text)
EOF

# wallpaper: omarchy art (or generated solid color), one per theme
WALL="$(ls "$T"/wallpaper.* 2>/dev/null | head -n1)"
if [ -n "$WALL" ]; then
  osascript -e "tell application \"System Events\" to tell every desktop to set picture to (POSIX file \"$WALL\")" >/dev/null 2>&1 || true
fi

# k9s: copy (not symlink) into its watched skins dir — k9s's fsnotify watcher
# only fires on writes to that exact directory, not on re-pointing a symlink
# elsewhere in the chain, so a real write is what makes reactive:true live-reload it.
K9S_SKIN="$HOME/Library/Application Support/k9s/skins/themer.yaml"
[ -f "$T/k9s.yaml" ] && cp "$T/k9s.yaml" "$K9S_SKIN"

# atuin/lazygit: read through symlinks — themed on next launch.
echo "theme: $1"
